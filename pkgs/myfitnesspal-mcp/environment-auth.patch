@@ -621 +621,37 @@
 def get_mfp_client():
+    """Use only explicitly injected cookies, without persistence or fallback."""
+    raw = os.environ.get("MFP_COOKIES_JSON", "")
+    try:
+        cookies = json.loads(raw)
+    except (ValueError, TypeError):
+        raise RuntimeError("MFP_COOKIES_JSON must contain a JSON cookie object") from None
+    if (
+        not isinstance(cookies, dict)
+        or not cookies
+        or not all(
+            isinstance(k, str) and k and isinstance(v, str) and v
+            and not any(c in k + v for c in "\r\n\x00")
+            for k, v in cookies.items()
+        )
+        or not _has_real_mfp_session(cookies)
+    ):
+        raise RuntimeError("MFP_COOKIES_JSON must contain non-empty session cookies")
+
+    import myfitnesspal
+    import requests
+    import cloudscraper
+
+    # Preserve upstream's workaround for MFP's Cloudflare TLS fingerprint check.
+    cloudscraper.create_scraper = lambda **kw: requests.Session()
+    try:
+        client = myfitnesspal.Client(cookiejar=dict_to_cookiejar(cookies))
+        client.get_date(date.today())
+        return client
+    except Exception:
+        # Neither log nor return authentication exceptions containing secrets.
+        raise RuntimeError(
+            "MyFitnessPal session authentication failed; replace MFP_COOKIES_JSON"
+        ) from None
+
+
