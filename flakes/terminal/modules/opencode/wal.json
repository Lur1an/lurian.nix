{{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {{
    "bg": "{color0}",
    "bgPanel": "{color0.lighten(3)}",
    "bgElement": "{color0.lighten(6)}",
    "borderSubtle": "{color0.lighten(9)}",
    "border": "{color0.lighten(14)}",
    "borderActive": "{color0.lighten(24)}",
    "fg": "{color15.lighten(4)}",
    "fgMuted": "{color8.lighten(18)}",
    "comment": "{color8.lighten(12)}",
    "red": "{color9.lighten(12)}",
    "softRed": "{color9.lighten(20)}",
    "gold": "{color10.lighten(4)}",
    "yellow": "{color11.lighten(10).saturate(45)}",
    "yellowBright": "{color11.lighten(18).saturate(45)}",
    "blue": "{color12.lighten(8)}",
    "purple": "{color13.lighten(8)}",
    "cyan": "{color14.lighten(10)}",
    "diffAddBg": "{color10.darken(72)}",
    "diffDelBg": "{color9.darken(60)}"
  }},
  "theme": {{
    "primary": "blue",
    "secondary": "purple",
    "accent": "cyan",

    "error": "red",
    "warning": "yellow",
    "success": "gold",
    "info": "blue",

    "text": "fg",
    "textMuted": "fgMuted",

    "background": "none",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElement",

    "border": "border",
    "borderActive": "borderActive",
    "borderSubtle": "borderSubtle",

    "diffAdded": "gold",
    "diffRemoved": "red",
    "diffContext": "fgMuted",
    "diffHunkHeader": "fgMuted",
    "diffHighlightAdded": "gold",
    "diffHighlightRemoved": "softRed",
    "diffAddedBg": "diffAddBg",
    "diffRemovedBg": "diffDelBg",
    "diffContextBg": "bgPanel",
    "diffLineNumber": "border",
    "diffAddedLineNumberBg": "diffAddBg",
    "diffRemovedLineNumberBg": "diffDelBg",

    "markdownText": "fg",
    "markdownHeading": "purple",
    "markdownLink": "blue",
    "markdownLinkText": "cyan",
    "markdownCode": "gold",
    "markdownBlockQuote": "comment",
    "markdownEmph": "yellowBright",
    "markdownStrong": "yellow",
    "markdownHorizontalRule": "fgMuted",
    "markdownListItem": "blue",
    "markdownListEnumeration": "cyan",
    "markdownImage": "blue",
    "markdownImageText": "cyan",
    "markdownCodeBlock": "fg",

    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "softRed",
    "syntaxString": "gold",
    "syntaxNumber": "yellowBright",
    "syntaxType": "yellow",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "fgMuted"
  }}
}}
