{{
  "$schema": "https://opencode.ai/theme.json",
  "base": {{
    "categorical": ["blue", "purple", "cyan", "green", "yellow", "orange"],
    "text": {{
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.400",
      "action": {{
        "primary": {{
          "base": "$hue.blue.200",
          "$hovered": "$hue.blue.100",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.neutral.900",
          "$pressed": "$hue.neutral.900",
          "$disabled": "$hue.neutral.500"
        }},
        "secondary": {{
          "base": "$hue.neutral.300",
          "$hovered": "$hue.cyan.100",
          "$focused": "$hue.cyan.100",
          "$selected": "$hue.cyan.100",
          "$disabled": "$hue.neutral.500"
        }},
        "destructive": {{
          "base": "$hue.red.200",
          "$hovered": "$hue.red.100",
          "$focused": "$hue.neutral.900",
          "$pressed": "$hue.neutral.900",
          "$disabled": "$hue.neutral.500"
        }}
      }},
      "formfield": {{
        "base": "$hue.neutral.100",
        "$hovered": "$hue.neutral.100",
        "$focused": "$hue.neutral.100",
        "$selected": "$hue.neutral.900",
        "$disabled": "$hue.neutral.500"
      }},
      "feedback": {{
        "error": {{"base": "$hue.red.200"}},
        "warning": {{"base": "$hue.yellow.200"}},
        "success": {{"base": "$hue.green.200"}},
        "info": {{"base": "$hue.blue.200"}}
      }}
    }},
    "background": {{
      "base": "transparent",
      "raised": {{
        "base": "{color0}b3",
        "high": "{color0.lighten(5)}b3",
        "max": "{color0.lighten(12)}b3"
      }},
      "action": {{
        "primary": {{
          "base": "transparent",
          "$hovered": "$hue.blue.900",
          "$focused": "$hue.blue.200",
          "$selected": "$hue.blue.200",
          "$pressed": "$hue.blue.300",
          "$disabled": "transparent"
        }},
        "secondary": {{
          "base": "transparent",
          "$hovered": "$hue.cyan.900",
          "$focused": "$hue.cyan.800",
          "$selected": "$hue.cyan.800"
        }},
        "destructive": {{
          "base": "transparent",
          "$hovered": "$hue.red.900",
          "$focused": "$hue.red.200",
          "$pressed": "$hue.red.300"
        }}
      }},
      "formfield": {{
        "base": "$background.raised.base",
        "$hovered": "$background.raised.high",
        "$focused": "$background.raised.high",
        "$selected": "$hue.blue.200"
      }},
      "feedback": {{
        "error": {{"base": "$background.base"}},
        "warning": {{"base": "$background.base"}},
        "success": {{"base": "$background.base"}},
        "info": {{"base": "$background.base"}}
      }}
    }},
    "border": {{"base": "$hue.blue.600"}},
    "scrollbar": {{"base": "$hue.blue.500"}},
    "diff": {{
      "text": {{
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.purple.200"
      }},
      "background": {{
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "transparent"
      }},
      "highlight": {{
        "added": "$hue.green.700",
        "removed": "$hue.red.700"
      }},
      "lineNumber": {{
        "text": "$hue.neutral.400",
        "background": {{
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }}
      }}
    }},
    "syntax": {{
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.300"
    }},
    "markdown": {{
      "text": "$hue.neutral.100",
      "heading": "$hue.purple.100",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.purple.200",
      "strong": "$hue.neutral.100",
      "horizontalRule": "$hue.blue.700",
      "listItem": "$hue.blue.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    }},
    "@dialog": {{
      "background": {{
        "base": "$hue.neutral.800",
        "raised": {{
          "base": "$hue.neutral.800",
          "high": "$hue.neutral.700",
          "max": "$hue.neutral.600"
        }},
        "formfield": {{
          "base": "$hue.neutral.900",
          "$selected": "$hue.blue.200"
        }}
      }},
      "border": {{"base": "$hue.blue.400"}}
    }}
  }},
  "dark": {{
    "hue": {{
      "gray": {{
        "100": "{color15.lighten(4)}",
        "200": "{color15}",
        "300": "{color7}",
        "400": "{color8.lighten(24)}",
        "500": "{color8.lighten(8)}",
        "600": "{color0.lighten(12)}",
        "700": "{color0.lighten(5)}",
        "800": "{color0}",
        "900": "{color0.darken(20)}"
      }},
      "red": {{
        "100": "{color9.lighten(24)}",
        "200": "{color9.lighten(12)}",
        "300": "{color9}",
        "400": "{color9.darken(12)}",
        "500": "{color9.darken(28)}",
        "600": "{color9.darken(44)}",
        "700": "{color9.darken(60)}",
        "800": "{color9.darken(76)}",
        "900": "{color9.darken(88)}"
      }},
      "orange": {{
        "100": "{color3.lighten(30)}",
        "200": "{color3.lighten(18)}",
        "300": "{color3.lighten(6)}",
        "400": "{color3.darken(6)}",
        "500": "{color3.darken(22)}",
        "600": "{color3.darken(40)}",
        "700": "{color3.darken(58)}",
        "800": "{color3.darken(74)}",
        "900": "{color3.darken(88)}"
      }},
      "yellow": {{
        "100": "{color11.lighten(24)}",
        "200": "{color11.lighten(12)}",
        "300": "{color11}",
        "400": "{color11.darken(12)}",
        "500": "{color11.darken(28)}",
        "600": "{color11.darken(44)}",
        "700": "{color11.darken(60)}",
        "800": "{color11.darken(76)}",
        "900": "{color11.darken(88)}"
      }},
      "green": {{
        "100": "{color10.lighten(24)}",
        "200": "{color10.lighten(12)}",
        "300": "{color10}",
        "400": "{color10.darken(12)}",
        "500": "{color10.darken(28)}",
        "600": "{color10.darken(44)}",
        "700": "{color10.darken(60)}",
        "800": "{color10.darken(76)}",
        "900": "{color10.darken(88)}"
      }},
      "cyan": {{
        "100": "{color14.lighten(24)}",
        "200": "{color14.lighten(12)}",
        "300": "{color14}",
        "400": "{color14.darken(12)}",
        "500": "{color14.darken(28)}",
        "600": "{color14.darken(44)}",
        "700": "{color14.darken(60)}",
        "800": "{color14.darken(76)}",
        "900": "{color14.darken(88)}"
      }},
      "blue": {{
        "100": "{color12.lighten(24)}",
        "200": "{color12.lighten(12)}",
        "300": "{color12}",
        "400": "{color12.darken(12)}",
        "500": "{color12.darken(28)}",
        "600": "{color12.darken(44)}",
        "700": "{color12.darken(60)}",
        "800": "{color12.darken(76)}",
        "900": "{color12.darken(88)}"
      }},
      "purple": {{
        "100": "{color13.lighten(24)}",
        "200": "{color13.lighten(12)}",
        "300": "{color13}",
        "400": "{color13.darken(12)}",
        "500": "{color13.darken(28)}",
        "600": "{color13.darken(44)}",
        "700": "{color13.darken(60)}",
        "800": "{color13.darken(76)}",
        "900": "{color13.darken(88)}"
      }},
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }}
  }}
}}
