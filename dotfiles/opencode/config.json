{
  "$schema": "https://opencode.ai/config.json",
  "theme": "wal",
  "permission": {
    "external_directory": {
      "~/.cargo/registry/**": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "dummy",
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      }
    }
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": ["mcp-grafana"],
      "enabled": false
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--isolated",
        "--browser=firefox",
        "--headless"
      ]
    },
    "v0": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.v0.dev",
        "--header",
        "Authorization: Bearer ${V0_API_KEY}"
      ],
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      }
    }
  }
}
