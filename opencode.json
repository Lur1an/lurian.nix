{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "kubectl": "ask",
      "kubectl *": "ask",
      "terraform": "ask",
      "terraform *": "ask"
    }
  },
  "provider": {
    "zai-coding-plan": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"]
    }
  }
}
